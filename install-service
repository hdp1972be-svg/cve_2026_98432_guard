#!/bin/bash
#
# install-service
#
# Install the systemd units for the CVE-2026-98432 XDP guard, deploy the
# whitelist, and enable both the loader and the daemon.
#
# Run once after the repository binaries have been built and deployed
# (./build, sudo ./install) and before you reboot. Requires root.
#
# Idempotent: safe to run repeatedly. Resets failed unit state so a
# previous bad attempt doesn't block a clean re-run.
#
# Note: this script does NOT manage a systemd mount unit for bpffs.
# Modern systemd refuses to manage API filesystems via .mount units
# ("bad unit file setting"). The install script mounts bpffs itself
# (mkdir -p /sys/fs/bpf; mountpoint -q || mount -t bpf bpf /sys/fs/bpf),
# which works on every distribution regardless of systemd version.

set -euo pipefail

# --- paths ---------------------------------------------------------------
SRC_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

GUARD_DIR="/etc/cve-2026-98432-guard"
UNIT_DIR="/etc/systemd/system"

LOADER_UNIT="mtcp-guard-load.service"
DAEMON_UNIT="mtcp-guardd.service"

# --- sanity --------------------------------------------------------------
for f in "$LOADER_UNIT" "$DAEMON_UNIT" "whitelist.conf"; do
    if [[ ! -r "$SRC_DIR/$f" ]]; then
        echo "[-] missing source file: $SRC_DIR/$f" >&2
        exit 1
    fi
done

if [[ ! -r "$GUARD_DIR/cve_2026_98432_guard.o" ]]; then
    echo "[-] $GUARD_DIR/cve_2026_98432_guard.o not found." >&2
    echo "    Run ./build && sudo ./install first." >&2
    exit 1
fi

# --- deploy units --------------------------------------------------------
echo "[+] ensuring $GUARD_DIR exists"
sudo install -d -m 0755 "$GUARD_DIR"

echo "[+] installing systemd units into $UNIT_DIR"
sudo install -m 0644 "$SRC_DIR/$LOADER_UNIT" "$UNIT_DIR/$LOADER_UNIT"
sudo install -m 0644 "$SRC_DIR/$DAEMON_UNIT" "$UNIT_DIR/$DAEMON_UNIT"

if [[ -e "$GUARD_DIR/whitelist.conf" ]]; then
    echo "[+] $GUARD_DIR/whitelist.conf already exists; leaving it untouched"
else
    echo "[+] installing whitelist.conf into $GUARD_DIR"
    sudo install -m 0644 "$SRC_DIR/whitelist.conf" \
        "$GUARD_DIR/whitelist.conf"
fi

# --- reload + reset ------------------------------------------------------
echo "[+] systemctl daemon-reload"
sudo systemctl daemon-reload

# Clear any failed state from a previous attempt.
sudo systemctl reset-failed "$LOADER_UNIT" 2>/dev/null || true
sudo systemctl reset-failed "$DAEMON_UNIT" 2>/dev/null || true

# Also clear a stale/failed mount unit from the previous attempt so
# systemd doesn't try to start it via the loader's Requires= dependency.
# The loader unit must NOT reference sys-fs-bpf.mount anymore.
sudo systemctl reset-failed sys-fs-bpf.mount 2>/dev/null || true
sudo rm -f /etc/systemd/system/sys-fs-bpf.mount
sudo systemctl daemon-reload

# --- loader --------------------------------------------------------------
echo "[+] enabling and starting $LOADER_UNIT"
if ! sudo systemctl enable --now "$LOADER_UNIT"; then
    echo "[-] failed to start $LOADER_UNIT" >&2
    echo "    Inspect with: journalctl -u $LOADER_UNIT --no-pager" >&2
    exit 1
fi

# Verify the maps are actually pinned before starting the daemon.
# The loader's ExecStart (/etc/.../install) mounts bpffs itself if needed.
if ! sudo test -e /sys/fs/bpf/cve_2026_98432_events; then
    echo "[-] events map not pinned after loader start." >&2
    echo "    Check: journalctl -u $LOADER_UNIT --no-pager" >&2
    echo "    Check: sudo ls -la /sys/fs/bpf/" >&2
    echo "    Check: mountpoint /sys/fs/bpf" >&2
    exit 1
fi

# --- daemon --------------------------------------------------------------
echo "[+] enabling and starting $DAEMON_UNIT"
if ! sudo systemctl enable --now "$DAEMON_UNIT"; then
    echo "[-] failed to start $DAEMON_UNIT" >&2
    echo "    Inspect with: journalctl -u $DAEMON_UNIT --no-pager" >&2
    exit 1
fi

# --- status --------------------------------------------------------------
echo
echo "[+] systemctl status:"
sudo systemctl --no-pager --lines=0 status \
    "$LOADER_UNIT" "$DAEMON_UNIT" || true

echo
echo "[+] done. To verify the guard is live:"
echo "    sudo $GUARD_DIR/mtcp-guard-ctl stats"
echo "    journalctl -u $DAEMON_UNIT -f"
