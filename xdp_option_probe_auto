#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
PROBE="$SCRIPT_DIR/xdp_option_probe"

if [[ $# -lt 1 || $# -gt 2 ]]; then
    echo "Usage: $0 <destination-ip> [destination-port]"
    exit 1
fi

DST_IP="$1"
DST_PORT="${2:-8080}"

if [[ ! -x "$PROBE" ]]; then
    echo "ERROR: Injector not found or not executable: $PROBE"
    exit 1
fi

if ! [[ "$DST_PORT" =~ ^[0-9]+$ ]] ||
   (( DST_PORT < 1 || DST_PORT > 65535 )); then
    echo "ERROR: Invalid destination port"
    exit 1
fi

# Validate IPv4 destination
python3 - "$DST_IP" <<'PY'
import ipaddress
import sys
try:
    ip = ipaddress.IPv4Address(sys.argv[1])
    if ip.is_multicast or ip.is_unspecified or ip.is_loopback:
        raise ValueError()
except ValueError:
    print("ERROR: Expected a valid unicast IPv4 destination")
    sys.exit(1)
PY

# Ask the kernel routing table how to reach the destination
ROUTE="$(ip -4 route get "$DST_IP" 2>/dev/null | head -n1)"

if [[ -z "$ROUTE" ]]; then
    echo "ERROR: No route to $DST_IP"
    exit 1
fi

DEV="$(awk '{for(i=1;i<=NF;i++) if($i=="dev"){print $(i+1); exit}}' <<< "$ROUTE")"
SRC_IP="$(awk '{for(i=1;i<=NF;i++) if($i=="src"){print $(i+1); exit}}' <<< "$ROUTE")"
GW="$(awk '{for(i=1;i<=NF;i++) if($i=="via"){print $(i+1); exit}}' <<< "$ROUTE")"

if [[ -z "$DEV" || -z "$SRC_IP" || "$DEV" == "lo" ]]; then
    echo "ERROR: No usable Ethernet interface for $DST_IP"
    echo "Route: $ROUTE"
    exit 1
fi

NEXT_HOP="${GW:-$DST_IP}"

# Resolve the Layer-2 destination
get_mac() {
    ip neigh show to "$NEXT_HOP" dev "$DEV" |
        awk '/lladdr/ && $0 !~ /FAILED|INCOMPLETE/ {
            for(i=1;i<=NF;i++)
                if($i=="lladdr"){print $(i+1); exit}
        }'
}

DST_MAC="$(get_mac)"

if [[ -z "$DST_MAC" ]]; then
    echo "[*] Resolving neighbour $NEXT_HOP via $DEV ..."
    ping -c 1 -W 1 -I "$DEV" "$NEXT_HOP" >/dev/null 2>&1 || true
    DST_MAC="$(get_mac)"
fi

if [[ -z "$DST_MAC" ]]; then
    echo "ERROR: Could not resolve MAC for $NEXT_HOP"
    echo "Neighbour entry:"
    ip neigh show to "$NEXT_HOP" dev "$DEV"
    exit 1
fi

echo
echo "XDP IPv4-options probe"
echo "----------------------"
echo "Destination : $DST_IP:$DST_PORT"
echo "Interface   : $DEV"
echo "Source IP   : $SRC_IP"
echo "Next hop    : $NEXT_HOP"
echo "Destination MAC: $DST_MAC"
echo

exec sudo "$PROBE" "$DEV" "$DST_MAC" "$SRC_IP" "$DST_IP" "$DST_PORT"
