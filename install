#!/bin/bash
#
# install
#
# Deploy and attach the CVE-2026-98432 XDP guard.
#
# Deployment directory:
#   /etc/cve-2026-98432-guard
#
# Usage:
#   sudo ./install [object-file]
#
# Existing unrelated XDP programs are never overwritten.

set -Eeuo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"

ETC_DIR="/etc/cve-2026-98432-guard"

PROG_PIN="/sys/fs/bpf/cve_2026_98432_guard"
MAP_PIN="/sys/fs/bpf/cve_2026_98432_stats"

OBJECT_SOURCE="${1:-$SCRIPT_DIR/cve_2026_98432_guard.o}"
OBJECT="$ETC_DIR/cve_2026_98432_guard.o"

GREEN='\033[0;32m'
YELLOW='\033[0;33m'
RED='\033[0;31m'
RESET='\033[0m'

info()  { printf "${GREEN}[+]${RESET} %s\n" "$*"; }
warn()  { printf "${YELLOW}[!]${RESET} %s\n" "$*"; }
error() { printf "${RED}[-]${RESET} %s\n" "$*" >&2; }

if [[ $EUID -ne 0 ]]; then
    error "Run as root: sudo $0"
    exit 1
fi

for cmd in ip bpftool mountpoint awk grep readlink cmp; do
    if ! command -v "$cmd" >/dev/null 2>&1; then
        error "Missing dependency: $cmd"
        exit 1
    fi
done

if [[ ! -f "$OBJECT_SOURCE" ]]; then
    error "Object file not found: $OBJECT_SOURCE"
    exit 1
fi

# --------------------------------------------------
# Deploy files to /etc
# --------------------------------------------------

info "Deploying guard to $ETC_DIR"

mkdir -p "$ETC_DIR"

deploy_file() {
    local source="$1"
    local destination="$2"
    local mode="$3"

    [[ -f "$source" ]] || return 0

    # Avoid copying a file onto itself.
    if [[ -e "$destination" && "$source" -ef "$destination" ]]; then
        return 0
    fi

    if [[ -e "$destination" ]] && cmp -s "$source" "$destination"; then
        return 0
    fi

    /usr/bin/install -m "$mode" "$source" "$destination"
    info "Deployed: $destination"
}

deploy_file "$OBJECT_SOURCE" "$OBJECT" 0644
deploy_file "$SCRIPT_PATH" "$ETC_DIR/install" 0755

if [[ -f "$SCRIPT_DIR/checkinstall.sh" ]]; then
    deploy_file "$SCRIPT_DIR/checkinstall.sh" \
        "$ETC_DIR/checkinstall.sh" 0755
fi

if [[ -f "$SCRIPT_DIR/README.md" ]]; then
    deploy_file "$SCRIPT_DIR/README.md" \
        "$ETC_DIR/README.md" 0644
fi

if [[ -f "$SCRIPT_DIR/mtcp-guardd" ]]; then
    deploy_file "$SCRIPT_DIR/mtcp-guardd" \
        "$ETC_DIR/mtcp-guardd" 0755
fi

if [[ -f "$SCRIPT_DIR/mtcp-guard-ctl" ]]; then
    deploy_file "$SCRIPT_DIR/mtcp-guard-ctl" \
        "$ETC_DIR/mtcp-guard-ctl" 0755
fi

if [[ -f "$SCRIPT_DIR/whitelist.conf" ]]; then
    deploy_file "$SCRIPT_DIR/whitelist.conf" \
        "$ETC_DIR/whitelist.conf" 0644
fi

# --------------------------------------------------
# BPF filesystem
# --------------------------------------------------

mkdir -p /sys/fs/bpf

if ! mountpoint -q /sys/fs/bpf; then
    info "Mounting BPF filesystem"
    mount -t bpf bpf /sys/fs/bpf
fi

# --------------------------------------------------
# Load or reuse pinned program
# --------------------------------------------------

if [[ -e "$PROG_PIN" ]]; then
    info "Reusing pinned program: $PROG_PIN"
else
    info "Loading XDP program from $OBJECT"
    bpftool prog load "$OBJECT" "$PROG_PIN" type xdp
fi

PROG_INFO="$(bpftool prog show pinned "$PROG_PIN")"
PROG_ID="${PROG_INFO%%:*}"

if [[ ! "$PROG_ID" =~ ^[0-9]+$ ]]; then
    error "Could not determine program ID"
    exit 1
fi

info "Program ID: $PROG_ID"

# --------------------------------------------------
# Statistics and auxiliary maps
# --------------------------------------------------

# Map identification by characteristics:
#   stats   : PERCPU_ARRAY  key=4 value=8  max_entries=2
#   whitelist: HASH         key=4 value=1  max_entries=512
#   whitelist_bm: ARRAY     key=4 value=4  max_entries=256
#   drop_ips : LRU_HASH     key=4 value=8  max_entries=4096
#   events   : PERF_EVENT_ARRAY key=4 value=4 max_entries=1024
#   config   : ARRAY        key=4 value=4  max_entries=1

MAP_NAMES="stats whitelist whitelist_bm drop_ips events config"
MAP_PATHS=""
for mname in $MAP_NAMES; do
    MAP_PATHS="$MAP_PATHS /sys/fs/bpf/cve_2026_98432_$mname"
done

# Extract all map IDs from program info
MAP_IDS="$(
    awk '
        /map_ids/ {
            for (i=1; i<=NF; i++)
                if ($i == "map_ids") {
                    for (j=i+1; j<=NF; j++)
                        print $j
                    exit
                }
        }
    ' <<< "$PROG_INFO"
)"

# Pin each map by matching characteristics
pin_map_by_id() {
    local map_id="$1"
    local map_info
    local map_type key_size value_size max_entries
    local target=""

    map_info="$(bpftool map show id "$map_id" 2>/dev/null || true)"
    [[ -z "$map_info" ]] && return 1

    map_type="$(awk '/type/ {print $2}' <<< "$map_info")"
    key_size="$(awk '/key/ {print $2}' <<< "$map_info")"
    value_size="$(awk '/value/ {print $2}' <<< "$map_info")"
    max_entries="$(awk '/max_entries/ {print $2}' <<< "$map_info")"

    case "$map_type" in
        percpu_array)
            [[ "$key_size" == "4" && "$value_size" == "8" && "$max_entries" == "2" ]] && target="stats"
            ;;
        hash)
            [[ "$key_size" == "4" && "$value_size" == "1" && "$max_entries" == "512" ]] && target="whitelist"
            [[ "$key_size" == "4" && "$value_size" == "8" && "$max_entries" == "4096" ]] && target="drop_ips"
            ;;
        array)
            [[ "$key_size" == "4" && "$value_size" == "4" && "$max_entries" == "256" ]] && target="whitelist_bm"
            [[ "$key_size" == "4" && "$value_size" == "4" && "$max_entries" == "1" ]] && target="config"
            ;;
        perf_event_array)
            [[ "$key_size" == "4" && "$value_size" == "4" && "$max_entries" == "1024" ]] && target="events"
            ;;
    esac

    [[ -z "$target" ]] && {
        warn "Unknown map (ID $map_id): type=$map_type key=$key_size value=$value_size max_entries=$max_entries"
        return 0
    }

    local map_pin="/sys/fs/bpf/cve_2026_98432_$target"

    if [[ -e "$map_pin" ]]; then
        local existing
        existing="$(bpftool map show pinned "$map_pin" 2>/dev/null || true)"
        local existing_id="${existing%%:*}"
        if [[ "$existing_id" == "$map_id" ]]; then
            info "$target map already pinned (ID $map_id)"
            return 0
        fi
        error "$target map pin refers to a different map!"
        error "Program map ID: $map_id"
        error "Pinned map ID : ${existing_id:-UNKNOWN}"
        exit 1
    fi

    bpftool map pin id "$map_id" "$map_pin"
    info "$target map pinned: $map_pin (ID $map_id)"
}

for map_id in $MAP_IDS; do
    [[ "$map_id" =~ ^[0-9]+$ ]] || continue
    pin_map_by_id "$map_id"
done

# --------------------------------------------------
# Attach XDP to interfaces
# --------------------------------------------------

echo
info "Scanning network interfaces"
echo

ATTACHED=0
ALREADY=0
SKIPPED=0
FAILED=0

for path in /sys/class/net/*; do
    [[ -e "$path" ]] || continue

    IFACE="${path##*/}"

    [[ "$IFACE" == "lo" ]] && continue

    CURRENT="$(bpftool net show dev "$IFACE" 2>/dev/null || true)"

    IDS="$(
        grep -Eo '(generic|xdpdrv|xdpoffload) id [0-9]+' \
            <<< "$CURRENT" || true
    )"

    if [[ -n "$IDS" ]]; then
        FOUND_EXPECTED=0

        while IFS= read -r ATTACHMENT; do
            [[ -n "$ATTACHMENT" ]] || continue

            CURRENT_ID="${ATTACHMENT##*id }"

            if [[ "$CURRENT_ID" == "$PROG_ID" ]]; then
                info "$IFACE: already attached ($ATTACHMENT)"
                FOUND_EXPECTED=1
            else
                warn "$IFACE: another XDP program attached ($ATTACHMENT)"
            fi
        done <<< "$IDS"

        if (( FOUND_EXPECTED )); then
            ((ALREADY+=1))
        else
            warn "$IFACE: existing XDP attachment, not overwritten"
            ((SKIPPED+=1))
        fi

        continue
    fi

    info "$IFACE: attaching generic XDP"

    if ip link set dev "$IFACE" xdpgeneric pinned "$PROG_PIN"; then
        info "$IFACE: attached successfully"
        ((ATTACHED+=1))
    else
        error "$IFACE: attachment failed"
        ((FAILED+=1))
    fi
done

# --------------------------------------------------
# Summary
# --------------------------------------------------

echo
echo "=============================================="
echo "       CVE-2026-98432 XDP GUARD"
echo "=============================================="
echo "Program ID       : $PROG_ID"
echo "Program pin      : $PROG_PIN"
echo "Object           : $OBJECT"
echo "Statistics map   : $MAP_PIN"
echo "Whitelist map    : /sys/fs/bpf/cve_2026_98432_whitelist"
echo "Whitelist bitmap : /sys/fs/bpf/cve_2026_98432_whitelist_bm"
echo "Drop IPs map     : /sys/fs/bpf/cve_2026_98432_drop_ips"
echo "Events map       : /sys/fs/bpf/cve_2026_98432_events"
echo "Config map       : /sys/fs/bpf/cve_2026_98432_config"
echo "New attachments  : $ATTACHED"
echo "Already attached : $ALREADY"
echo "Other XDP        : $SKIPPED"
echo "Failed           : $FAILED"
echo "=============================================="

echo
info "Current XDP attachments:"
bpftool net show

if (( FAILED > 0 )); then
    error "Some interfaces could not be attached"
    exit 1
fi

info "Deployment and attachment complete."
