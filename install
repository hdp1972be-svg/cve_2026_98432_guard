#!/bin/bash
#
# install
#
# deploy and attach the cve-2026-98432 xdp guard.
#
# deployment directory:
#   /etc/cve-2026-98432-guard
#
# usage:
#   sudo ./install [object-file]
#
# existing unrelated xdp programs are never overwritten.

set -uo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"

ETC_DIR="/etc/cve-2026-98432-guard"

PROG_PIN="/sys/fs/bpf/cve_2026_98432_guard"
MAP_PIN="/sys/fs/bpf/cve_2026_98432_stats"

OBJECT_SOURCE="${1:-$SCRIPT_DIR/cve_2026_98432_guard.o}"
OBJECT="$ETC_DIR/cve_2026_98432_guard.o"

GREEN='\033[0;32m'
YELLOW='\033[0;33m'
RED='\033[0;31m'
RESET='\033[0m'

info()  { printf "${GREEN}[+]${RESET} %s\n" "$*"; }
warn()  { printf "${YELLOW}[!]${RESET} %s\n" "$*"; }
error() { printf "${RED}[-]${RESET} %s\n" "$*" >&2; }

if [[ $EUID -ne 0 ]]; then
    error "run as root: sudo $0"
    exit 1
fi

for cmd in ip bpftool mountpoint awk grep readlink cmp; do
    if ! command -v "$cmd" >/dev/null 2>&1; then
        error "missing dependency: $cmd"
        exit 1
    fi
done

if [[ ! -f "$OBJECT_SOURCE" ]]; then
    error "object file not found: $OBJECT_SOURCE"
    exit 1
fi

# --------------------------------------------------
# deploy files to /etc
# --------------------------------------------------

info "deploying guard to $ETC_DIR"

mkdir -p "$ETC_DIR"

deploy_file() {
    local source="$1" destination="$2" mode="$3"
    [[ -f "$source" ]] || return 0
    if [[ -e "$destination" && "$source" -ef "$destination" ]]; then return 0; fi
    if [[ -e "$destination" ]] && cmp -s "$source" "$destination"; then return 0; fi
    /usr/bin/install -m "$mode" "$source" "$destination" || return 1
    info "deployed: $destination"
}

deploy_file "$OBJECT_SOURCE" "$OBJECT" 0644 || { error "deploy failed"; exit 1; }
deploy_file "$SCRIPT_PATH" "$ETC_DIR/install" 0755 || true

for extra in checkinstall.sh readme.md mtcp-guardd mtcp-guard-ctl whitelist.conf; do
    if [[ -f "$SCRIPT_DIR/$extra" ]]; then
        mode=0644
        case "$extra" in
            *.sh|mtcp-guardd|mtcp-guard-ctl) mode=0755 ;;
        esac
        deploy_file "$SCRIPT_DIR/$extra" "$ETC_DIR/$extra" "$mode" || true
    fi
done

# --------------------------------------------------
# bpf filesystem
# --------------------------------------------------

mkdir -p /sys/fs/bpf
if ! mountpoint -q /sys/fs/bpf; then
    info "mounting bpf filesystem"
    mount -t bpf bpf /sys/fs/bpf || { error "mount bpffs failed"; exit 1; }
fi

# --------------------------------------------------
# load or reuse pinned program
# --------------------------------------------------

if [[ -e "$PROG_PIN" ]]; then
    info "reusing pinned program: $PROG_PIN"
else
    info "loading xdp program from $OBJECT"
    if ! bpftool prog load "$OBJECT" "$PROG_PIN" type xdp; then
        error "bpftool prog load failed"
        exit 1
    fi
fi

PROG_NAME_FULL="xdp_cve_2026_98432_guard"
PROG_NAME_TRUNC="${PROG_NAME_FULL:0:15}"

PROG_ID=""
PROG_SHOW_ALL="$(bpftool prog show 2>/dev/null || true)"

if [[ -n "$PROG_SHOW_ALL" ]]; then
    PROG_ID="$(printf '%s\n' "$PROG_SHOW_ALL" \
        | awk -v n="$PROG_NAME_TRUNC" \
              '$0 ~ "^[0-9]+: " && $0 ~ ("name " n) {
                  sub(":", "", $1); print $1; exit }')"
fi

if [[ ! "$PROG_ID" =~ ^[0-9]+$ ]] && [[ -n "$PROG_SHOW_ALL" ]]; then
    while read -r cand_id; do
        [[ "$cand_id" =~ ^[0-9]+$ ]] || continue
        detail="$(bpftool prog show id "$cand_id" 2>/dev/null || true)"
        if printf '%s' "$detail" | grep -Fq "pinned $PROG_PIN"; then
            PROG_ID="$cand_id"
            break
        fi
    done < <(printf '%s\n' "$PROG_SHOW_ALL" | awk -F: '/^[0-9]+:/ {print $1}')
fi

if [[ ! "$PROG_ID" =~ ^[0-9]+$ ]]; then
    error "could not determine program id"
    error "--- bpftool prog show (for diagnosis) ---"
    bpftool prog show 2>&1 | sed 's/^/    /' >&2 || true
    error "--- end ---"
    exit 1
fi

info "program id: $PROG_ID"

# --------------------------------------------------
# pin auxiliary maps
#
# Shape-based assignment: each map is identified by its
# (type, key_size, value_size, max_entries) tuple, read from
# `bpftool map show id N` text output. This works on every
# bpftool version because the text form has been stable for
# years, unlike the JSON form whose schema varies.
# --------------------------------------------------

declare -A EXPECT=(
    [stats]="percpu_array 4 8 3"
    [whitelist]="hash 4 1 4096"
    [whitelist_bm]="hash 4 1 4096"
    [drop_ips]="lru_hash 4 8 4096"
    [events]="perf_event_array 4 4 1024"
    [config]="array 4 4 1"
)

PROG_DETAIL="$(bpftool prog show id "$PROG_ID" 2>/dev/null || true)"
if [[ -z "$PROG_DETAIL" ]]; then
    error "bpftool prog show id $PROG_ID returned nothing"
    exit 1
fi

MAP_IDS=""
MAP_IDS="$(printf '%s\n' "$PROG_DETAIL" \
    | awk '
        /map_ids/ {
            for (i = 1; i <= NF; i++) {
                if ($i == "map_ids") {
                    for (j = i + 1; j <= NF; j++) print $j
                    exit
                }
            }
        }' \
    | tr ',' ' ' || true)"

if [[ -z "$MAP_IDS" ]]; then
    error "could not extract map_ids from program $PROG_ID"
    printf '%s\n' "$PROG_DETAIL" | sed 's/^/    /' >&2
    exit 1
fi

# Read shape from text output. Example text:
#   80: percpu_array  name cve_2026_98432_  flags 0x0
#           key 4B  value 8B  max_entries 3  memlock 4096B
# Produces: "percpu_array 4 8 3"
map_shape() {
    local id="$1" raw type_word key_v value_v max_v
    raw="$(bpftool map show id "$id" 2>/dev/null || true)"
    [[ -n "$raw" ]] || return 1

    # First line: "80: percpu_array  name ..."
    type_word="$(printf '%s\n' "$raw" \
        | awk 'NR==1 { for (i=2; i<=NF; i++) { if ($i=="name") break; if ($i ~ /^[a-z_]+$/) { print $i; exit } } }')"

    # Second-ish line: "key 4B  value 8B  max_entries 3  memlock 4096B"
    key_v="$(printf '%s\n' "$raw" \
        | grep -oE 'key [0-9]+B' | head -1 | grep -oE '[0-9]+')"
    value_v="$(printf '%s\n' "$raw" \
        | grep -oE 'value [0-9]+B' | head -1 | grep -oE '[0-9]+')"
    max_v="$(printf '%s\n' "$raw" \
        | grep -oE 'max_entries [0-9]+' | head -1 | grep -oE '[0-9]+')"

    [[ -n "$type_word" && -n "$key_v" && -n "$value_v" && -n "$max_v" ]] || {
        # Fallback: dump what we could not parse, for diagnostics.
        warn "could not parse shape for map id $id"
        printf '%s\n' "$raw" | sed 's/^/    /' >&2
        return 1
    }
    printf '%s %s %s %s\n' "$type_word" "$key_v" "$value_v" "$max_v"
}

declare -A by_shape=()
for id in $MAP_IDS; do
    [[ "$id" =~ ^[0-9]+$ ]] || continue
    shape="$(map_shape "$id")" || continue
    by_shape[$shape]+="$id "
done

declare -A assigned=()
for name in stats drop_ips events config; do
    want="${EXPECT[$name]}"
    read -r -a arr <<< "${by_shape[$want]:-}"
    if (( ${#arr[@]} == 1 )); then
        assigned[$name]="${arr[0]}"
    elif (( ${#arr[@]} == 0 )); then
        error "no map matches shape for '$name' ($want)"
        error "shapes seen: ${!by_shape[*]}"
        exit 1
    else
        error "multiple maps match shape for '$name': ${arr[*]}"
        exit 1
    fi
done

want_hash="${EXPECT[whitelist]}"
read -r -a hash_ids <<< "${by_shape[$want_hash]:-}"
if (( ${#hash_ids[@]} == 2 )); then
    mapfile -t hash_ids < <(printf '%s\n' "${hash_ids[@]}" | sort -n)
    assigned[whitelist]="${hash_ids[0]}"
    assigned[whitelist_bm]="${hash_ids[1]}"
elif (( ${#hash_ids[@]} == 1 )); then
    assigned[whitelist]="${hash_ids[0]}"
else
    error "expected two hash-shaped maps, found ${#hash_ids[@]}: ${hash_ids[*]:-none}"
    exit 1
fi

MAP_SHOW="$(bpftool map show 2>/dev/null || true)"
map_pin_id() {
    local pin="$1"
    [[ -n "$MAP_SHOW" ]] || { echo ""; return; }
    awk -v pin="$pin" '
        /^[0-9]+:/ { current_id = $1; sub(":", "", current_id) }
        $0 ~ ("pinned " pin "$") { print current_id; exit }
    ' <<< "$MAP_SHOW"
}

for name in stats whitelist whitelist_bm drop_ips events config; do
    id="${assigned[$name]:-}"
    [[ -n "$id" ]] || { error "no id assigned for $name"; exit 1; }
    pin="/sys/fs/bpf/cve_2026_98432_$name"
    existing_id="$(map_pin_id "$pin")"
    if [[ -n "$existing_id" ]]; then
        if [[ "$existing_id" == "$id" ]]; then
            info "$name map already pinned (id $id)"
            continue
        fi
        error "$name pin exists but refers to a different map"
        error "  pinned id : $existing_id"
        error "  wanted id : $id"
        exit 1
    fi
    shape="$(map_shape "$id" 2>/dev/null || true)"
    if [[ "$shape" != "${EXPECT[$name]}" ]]; then
        error "map $id shape mismatch for $name"
        error "  expected: ${EXPECT[$name]}"
        error "  actual:   ${shape:-<unreadable>}"
        exit 1
    fi
    if bpftool map pin id "$id" "$pin"; then
        info "$name map pinned: $pin (id $id)"
    else
        error "failed to pin $name map (id $id) to $pin"
        exit 1
    fi
done

# --------------------------------------------------
# attach xdp to interfaces
# --------------------------------------------------

echo
info "scanning network interfaces"
echo

attached=0; already=0; skipped=0; failed=0

for path in /sys/class/net/*; do
    [[ -e "$path" ]] || continue
    iface="${path##*/}"
    [[ "$iface" == "lo" ]] && continue
    current="$(bpftool net show dev "$iface" 2>/dev/null || true)"
    ids="$(grep -Eo '(generic|xdpdrv|xdpoffload) id [0-9]+' <<< "$current" || true)"
    if [[ -n "$ids" ]]; then
        found_expected=0
        while IFS= read -r attachment; do
            [[ -n "$attachment" ]] || continue
            current_id="${attachment##*id }"
            if [[ "$current_id" == "$PROG_ID" ]]; then
                info "$iface: already attached ($attachment)"
                found_expected=1
            else
                warn "$iface: another xdp program attached ($attachment)"
            fi
        done <<< "$ids"
        if (( found_expected )); then ((already+=1)); else
            warn "$iface: existing xdp attachment, not overwritten"
            ((skipped+=1))
        fi
        continue
    fi
    info "$iface: attaching generic xdp"
    if ip link set dev "$iface" xdpgeneric pinned "$PROG_PIN"; then
        info "$iface: attached successfully"
        ((attached+=1))
    else
        error "$iface: attachment failed"
        ((failed+=1))
    fi
done

# --------------------------------------------------
# summary
# --------------------------------------------------

echo
echo "=============================================="
echo "       CVE-2026-98432 XDP GUARD"
echo "=============================================="
echo "Program ID       : $PROG_ID"
echo "Program pin      : $PROG_PIN"
echo "Object           : $OBJECT"
echo "Statistics map   : /sys/fs/bpf/cve_2026_98432_stats"
echo "Whitelist map    : /sys/fs/bpf/cve_2026_98432_whitelist"
echo "Whitelist bitmap : /sys/fs/bpf/cve_2026_98432_whitelist_bm"
echo "Drop IPs map     : /sys/fs/bpf/cve_2026_98432_drop_ips"
echo "Events map       : /sys/fs/bpf/cve_2026_98432_events"
echo "Config map       : /sys/fs/bpf/cve_2026_98432_config"
echo "New attachments  : $attached"
echo "Already attached : $already"
echo "Other XDP        : $skipped"
echo "Failed           : $failed"
echo "=============================================="

echo
info "current xdp attachments:"
bpftool net show || true

if (( failed > 0 )); then
    error "some interfaces could not be attached"
    exit 1
fi

info "deployment and attachment complete."
