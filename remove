#!/usr/bin/env bash
# remove — remove the cve_2026_98432 XDP BPF filter only.
#
# This script removes the runtime BPF filter (pinned program + maps, XDP
# attachments, daemon stop, PID file). It intentionally does NOT remove:
#   - systemd unit files (mtcp-guard.service, mtcp-guardd.service)
#   - /etc/cve-2026_98432_guard/ directory and whitelist.conf
set -Eeuo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

PROG_PIN="/sys/fs/bpf/cve_2026_98432_guard"
MAPS=(
    /sys/fs/bpf/cve_2026_98432_stats
    /sys/fs/bpf/cve_2026_98432_whitelist
    /sys/fs/bpf/cve_2026_98432_whitelist_bm
    /sys/fs/bpf/cve_2026_98432_drop_ips
    /sys/fs/bpf/cve_2026_98432_events
    /sys/fs/bpf/cve_2026_98432_config
)
PID_FILE="/run/mtcp-guardd.pid"

fail() {
    printf '[ERROR] %s\n' "$*" >&2
    exit 1
}

info()  { printf '[INFO]  %s\n' "$*"; }
warn()  { printf '[WARN]  %s\n' "$*"; }

# ---------------------------------------------------------------------------
# 1. Stop mtcp-guardd.service (so it stops consuming perf events)
# ---------------------------------------------------------------------------
if command -v systemctl >/dev/null 2>&1; then
    info "Stopping mtcp-guardd.service..."
    systemctl stop mtcp-guardd.service 2>/dev/null || true
else
    warn "systemctl not found; skipping daemon stop"
fi

# ---------------------------------------------------------------------------
# 2. Detach XDP from all network interfaces matching our program ID
# ---------------------------------------------------------------------------
info "Detaching XDP from network interfaces..."

if command -v ip >/dev/null 2>&1 && command -v bpftool >/dev/null 2>&1; then
    if [[ -e "$PROG_PIN" ]]; then
        PROG_ID="$(bpftool prog show pinned "$PROG_PIN" 2>/dev/null || true)"
        PROG_ID="${PROG_ID%%:*}"
    else
        PROG_ID=""
    fi

    if [[ -n "$PROG_ID" && "$PROG_ID" =~ ^[0-9]+$ ]]; then
        for path in /sys/class/net/*; do
            [[ -e "$path" ]] || continue
            IFACE="${path##*/}"
            [[ "$IFACE" == "lo" ]] && continue

            CURRENT="$(bpftool net show dev "$IFACE" 2>/dev/null || true)"
            IDS="$(grep -Eo '(generic|xdpdrv|xdpoffload) id [0-9]+' <<< "$CURRENT" || true)"

            if [[ -n "$IDS" ]]; then
                while IFS= read -r ATTACHMENT; do
                    [[ -n "$ATTACHMENT" ]] || continue
                    CURRENT_ID="${ATTACHMENT##*id }"
                    if [[ "$CURRENT_ID" == "$PROG_ID" ]]; then
                        if ip link set dev "$IFACE" xdp off 2>/dev/null; then
                            info "XDP detached from $IFACE"
                        else
                            warn "Could not detach XDP from $IFACE"
                        fi
                    fi
                done <<< "$IDS"
            fi
        done
    else
        warn "Could not determine program ID; skipping XDP detachment"
    fi
else
    warn "ip or bpftool not found; skipping XDP detachment"
fi

# ---------------------------------------------------------------------------
# 3. Remove pinned BPF program and maps
# ---------------------------------------------------------------------------
info "Removing pinned BPF objects..."

if [[ -e "$PROG_PIN" ]]; then
    rm -f -- "$PROG_PIN"
    info "Removed pinned program: $PROG_PIN"
fi

for map in "${MAPS[@]}"; do
    if [[ -e "$map" ]]; then
        rm -f -- "$map"
        info "Removed pinned map: $map"
    fi
done

# ---------------------------------------------------------------------------
# 4. Remove PID file
# ---------------------------------------------------------------------------
if [[ -e "$PID_FILE" ]]; then
    rm -f -- "$PID_FILE"
    info "Removed: $PID_FILE"
fi

echo
info "Removal complete. The cve_2026_98432 XDP BPF filter has been removed."
info "Note: systemd service files and /etc/cve-2026_98432_guard/ are kept."
info "      Pinned BPF objects exist only for the lifetime of the running kernel."
info "      A reboot will also clear any remaining BPF state."
