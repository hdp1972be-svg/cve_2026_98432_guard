#!/usr/bin/env bash
set -Eeuo pipefail

# Force a UTF-8 locale so ${#var} and printf %-*s treat box-drawing
# characters and multibyte values consistently.
export LC_ALL="${LC_ALL:-C.UTF-8}"

# ---------------------------------------------------------------------------
# Color support (only when stdout is a terminal)
# ---------------------------------------------------------------------------
if [[ -t 1 ]]; then
    C_RED='\033[0;31m'
    C_GREEN='\033[0;32m'
    C_YELLOW='\033[0;33m'
    C_BLUE='\033[0;34m'
    C_BOLD='\033[1m'
    C_RESET='\033[0m'
else
    C_RED=''
    C_GREEN=''
    C_YELLOW=''
    C_BLUE=''
    C_BOLD=''
    C_RESET=''
fi

ok()    { printf '%b[OK]%b %s\n'    "$C_GREEN" "$C_RESET" "$*"; }
warn()  { printf '%b[WARN]%b %s\n'  "$C_YELLOW" "$C_RESET" "$*"; }
info()  { printf '%b[INFO]%b %s\n'  "$C_BLUE" "$C_RESET" "$*"; }
err()   { printf '%b[ERROR]%b %s\n' "$C_RED" "$C_RESET" "$*" >&2; }

# ---------------------------------------------------------------------------
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

SRC_DIR="$SCRIPT_DIR/src"

CLANG="${CLANG:-clang}"
CC="${CC:-gcc}"

# ---------------------------------------------------------------------------
# Usage / help
# ---------------------------------------------------------------------------
usage() {
    cat <<'EOF'
NAME
    build.sh - build the CVE-2026-98432 XDP mitigation

SYNOPSIS
    ./build.sh [OPTIONS]

DESCRIPTION
    Compiles the eBPF XDP guard and (when libbpf is available) the
    userspace daemon and control utility.

    Source files are read from ./src/. Build artifacts are written to
    the top-level directory (next to this script).

    The eBPF object is named after the target kernel:
        cve_2026_98432_guard-k<major>.<minor>.o
    so multi-kernel systems keep one .o per kernel in the same tree
    without clobbering each other. The daemon, ctl and probe are
    kernel-independent and keep their plain names.

OPTIONS
    --kernel X.Y
        Target kernel version, e.g. 4.18, 5.10, 6.6.
        Default: auto-detect from the running kernel via uname -r.
        Affects both map ABI and perf helper ID selection, and the
        name of the produced .o file.

    --legacy-maps
        Force legacy struct bpf_map_def map ABI (required on kernels
        older than 5.3, and on toolchains that cannot emit BTF).
        Default: auto (legacy for < 5.3, BTF-style for >= 5.3).

    --btf-maps
        Force BTF-style map definitions (kernels >= 5.3 with modern
        libbpf/clang).

    --perf-helper-id N
        Override the bpf_perf_event_output helper ID.
        Default: auto (26 for kernels < 5.0, 25 for >= 5.0).

    --no-userspace
        Skip building mtcp-guardd and mtcp-guard-ctl even if libbpf
        is installed. Useful for eBPF-only CI builds.

    --no-pcap
        Do not build pcap capture into the daemon even if libpcap is
        available. Useful for a minimal daemon binary.

    -h, --help
        Show this help text and exit.

ENVIRONMENT
    CLANG                          Clang binary (default: clang)
    CC                             GCC binary   (default: gcc)
    BPF_FUNC_PERF_EVENT_OUTPUT     Same as --perf-helper-id
    LC_ALL                         Forced to C.UTF-8 unless already set

    CLI flags take precedence over environment variables, which in turn
    take precedence over auto-detection.

EXIT CODES
    0   Success (or --help)
    1   Build or capability-check failure
    2   Invalid command-line argument or unparsable kernel version

EXAMPLES
    ./build.sh
        Build for the running kernel. Produces
        cve_2026_98432_guard-k<major>.<minor>.o.

    ./build.sh --kernel 5.10
        Cross-build for kernel 5.10 (BTF maps, perf helper 25).
        Produces cve_2026_98432_guard-k5.10.o.

    ./build.sh --kernel 4.19 --legacy-maps
        Cross-build for 4.19, forcing the legacy map ABI.
        Produces cve_2026_98432_guard-k4.19.o.

    ./build.sh --btf-maps --perf-helper-id 25
        Force BTF maps and helper ID 25 on top of auto-detected kernel.

    ./build.sh --no-userspace
        Build only the eBPF object and packet probe.

    ./build.sh --no-pcap
        Build userspace tools without pcap capture support.

    ./build.sh --help
        Show this help.
EOF
}

# ---------------------------------------------------------------------------
# CLI parsing
# ---------------------------------------------------------------------------
KERNEL_ARG=""
MAPS_MODE="auto"           # auto | legacy | btf
PERF_HELPER_ARG=""
BUILD_USERSPACE=1
BUILD_PCAP=1

while [[ $# -gt 0 ]]; do
    case "$1" in
        --kernel)
            [[ $# -ge 2 ]] || { err "--kernel requires a value"; exit 2; }
            KERNEL_ARG="$2"
            shift 2
            ;;
        --kernel=*)
            KERNEL_ARG="${1#*=}"
            shift
            ;;
        --legacy-maps)
            MAPS_MODE="legacy"
            shift
            ;;
        --btf-maps)
            MAPS_MODE="btf"
            shift
            ;;
        --perf-helper-id)
            [[ $# -ge 2 ]] || { err "--perf-helper-id requires a value"; exit 2; }
            PERF_HELPER_ARG="$2"
            shift 2
            ;;
        --perf-helper-id=*)
            PERF_HELPER_ARG="${1#*=}"
            shift
            ;;
        --no-userspace)
            BUILD_USERSPACE=0
            shift
            ;;
        --no-pcap)
            BUILD_PCAP=0
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            err "Unknown argument: $1"
            echo
            usage >&2
            exit 2
            ;;
    esac
done

# ---------------------------------------------------------------------------
# Kernel version detection
# ---------------------------------------------------------------------------
# version_at_least MAJOR MINOR THRESH_MAJOR THRESH_MINOR
version_at_least() {
    local mj="$1" mn="$2" tmj="$3" tmn="$4"
    if (( mj > tmj )); then return 0; fi
    if (( mj < tmj )); then return 1; fi
    (( mn >= tmn ))
}

echo "=== cve_2026_98432 XDP build ==="
info "Source directory: $SCRIPT_DIR"
info "C sources:        $SRC_DIR"
echo

if [[ -n "$KERNEL_ARG" ]]; then
    TARGET_KERNEL="$KERNEL_ARG"
    KERNEL_SOURCE="CLI (--kernel)"
    info "Kernel detection: SKIPPED (explicit --kernel provided)"
    info "Target kernel:    $TARGET_KERNEL (from $KERNEL_SOURCE)"
else
    info "Kernel detection: no --kernel given, auto-detecting running kernel..."
    echo

    if command -v uname >/dev/null 2>&1; then
        DETECTED_REL="$(uname -r 2>/dev/null || true)"
        if [[ -n "$DETECTED_REL" ]]; then
            printf '  %b·%b uname -r               -> %s\n' \
                "$C_BOLD" "$C_RESET" "$DETECTED_REL"
            DETECTED_VIA="uname -r"
        else
            printf '  %b·%b uname -r               -> (empty)\n' \
                "$C_BOLD" "$C_RESET"
            DETECTED_REL=""
        fi
    else
        printf '  %b·%b uname                  -> not found\n' \
            "$C_BOLD" "$C_RESET"
        DETECTED_REL=""
    fi

    if [[ -z "$DETECTED_REL" ]] && [[ -r /proc/sys/kernel/osrelease ]]; then
        DETECTED_REL="$(< /proc/sys/kernel/osrelease)"
        printf '  %b·%b /proc/sys/kernel/osrelease -> %s\n' \
            "$C_BOLD" "$C_RESET" "$DETECTED_REL"
        DETECTED_VIA="/proc/sys/kernel/osrelease"
    fi

    if [[ -z "$DETECTED_REL" ]] && command -v getconf >/dev/null 2>&1; then
        DETECTED_REL="$(getconf GNU_LINUX_VERSION 2>/dev/null || true)"
        if [[ -n "$DETECTED_REL" ]]; then
            printf '  %b·%b getconf GNU_LINUX_VERSION -> %s\n' \
                "$C_BOLD" "$C_RESET" "$DETECTED_REL"
            DETECTED_VIA="getconf GNU_LINUX_VERSION"
        fi
    fi

    [[ -n "$DETECTED_REL" ]] || {
        err "Could not auto-detect the running kernel version."
        err "Pass --kernel X.Y explicitly."
        exit 2
    }

    TARGET_KERNEL="$DETECTED_REL"
    KERNEL_SOURCE="auto-detect ($DETECTED_VIA)"
    info "Target kernel:    $TARGET_KERNEL (from $KERNEL_SOURCE)"
fi

KERNEL_MM="$(printf '%s\n' "$TARGET_KERNEL" \
    | sed -nE 's/^([0-9]+)\.([0-9]+).*/\1 \2/p')"
if [[ -z "$KERNEL_MM" ]]; then
    err "Could not parse kernel version '$TARGET_KERNEL'."
    err "Pass --kernel X.Y explicitly if uname -r is unusual."
    exit 2
fi
KERNEL_MAJOR="${KERNEL_MM% *}"
KERNEL_MINOR="${KERNEL_MM#* }"
info "Parsed kernel:    major=$KERNEL_MAJOR minor=$KERNEL_MINOR"

# ---------------------------------------------------------------------------
# Resolve map ABI
# ---------------------------------------------------------------------------
case "$MAPS_MODE" in
    legacy)
        LEGACY_MAPS=1
        MAPS_SOURCE="CLI (--legacy-maps)"
        ;;
    btf)
        LEGACY_MAPS=0
        MAPS_SOURCE="CLI (--btf-maps)"
        ;;
    auto)
        if version_at_least "$KERNEL_MAJOR" "$KERNEL_MINOR" 5 3; then
            LEGACY_MAPS=0
            MAPS_SOURCE="auto (kernel >= 5.3)"
        else
            LEGACY_MAPS=1
            MAPS_SOURCE="auto (kernel < 5.3)"
        fi
        ;;
esac

# ---------------------------------------------------------------------------
# Resolve bpf_perf_event_output helper ID
# ---------------------------------------------------------------------------
if [[ -n "$PERF_HELPER_ARG" ]]; then
    PERF_EVENT_OUTPUT_ID="$PERF_HELPER_ARG"
    PERF_SOURCE="CLI (--perf-helper-id)"
elif [[ -n "${BPF_FUNC_PERF_EVENT_OUTPUT:-}" ]]; then
    PERF_EVENT_OUTPUT_ID="${BPF_FUNC_PERF_EVENT_OUTPUT}"
    PERF_SOURCE="env (BPF_FUNC_PERF_EVENT_OUTPUT)"
elif version_at_least "$KERNEL_MAJOR" "$KERNEL_MINOR" 5 0; then
    PERF_EVENT_OUTPUT_ID=25
    PERF_SOURCE="auto (kernel >= 5.0)"
else
    PERF_EVENT_OUTPUT_ID=26
    PERF_SOURCE="auto (kernel < 5.0)"
fi

[[ "$PERF_EVENT_OUTPUT_ID" =~ ^[0-9]+$ ]] || {
    err "Invalid perf_event_output helper ID: $PERF_EVENT_OUTPUT_ID"
    exit 2
}

# ---------------------------------------------------------------------------
# Print resolved configuration summary
# ---------------------------------------------------------------------------
MAP_ABI_STR="legacy (struct bpf_map_def)"
[[ "$LEGACY_MAPS" -eq 0 ]] && MAP_ABI_STR="BTF-style"

LABEL_W=30
VALUE_W=40

render_row() {
    local label="$1" value="$2"
    (( ${#label} > LABEL_W )) && label="${label:0:LABEL_W}"
    (( ${#value} > VALUE_W )) && value="${value:0:VALUE_W}"
    printf ' %-*s %-*s ' "$LABEL_W" "$label" "$VALUE_W" "$value"
}

INNER_W=$(( LABEL_W + VALUE_W + 3 ))
BORDER="$(awk -v n="$INNER_W" 'BEGIN{ for(i=0;i<n;i++) printf "─"; }')"

TITLE_ROW="$(render_row "Resolved build configuration" "")"

echo "  ┌${BORDER}┐"
printf '  │%s│\n' "$TITLE_ROW"
echo "  ├${BORDER}┤"

while IFS='|' read -r label value; do
    row="$(render_row "$label" "$value")"
    printf '  │%s│\n' "$row"
done <<EOF
Target kernel:|$TARGET_KERNEL
Kernel source:|$KERNEL_SOURCE
Map ABI:|$MAP_ABI_STR
Map ABI source:|$MAPS_SOURCE
perf_event_output ID:|$PERF_EVENT_OUTPUT_ID
perf helper source:|$PERF_SOURCE
EOF

echo "  └${BORDER}┘"
echo

# ---------------------------------------------------------------------------
# Source paths (all .c files under ./src)
# ---------------------------------------------------------------------------
GUARD_SRC="$SRC_DIR/cve_2026_98432_guard.c"
PROBE_SRC="$SRC_DIR/xdp_option_probe.c"
DAEMON_SRC="$SRC_DIR/mtcp-guardd.c"
DAEMON_PCAP_SRC="$SRC_DIR/pcap_writer.c"
DAEMON_PCAP_HDR="$SRC_DIR/pcap_writer.h"
CTL_SRC="$SRC_DIR/mtcp-guard-ctl.c"

# ---------------------------------------------------------------------------
# Artifact paths.
#
# The eBPF object is kernel-version-specific: its map ABI and perf
# helper ID are baked in at compile time, so one .o cannot serve two
# different kernels. Naming it after the target kernel lets multi-boot
# systems keep both:
#
#   cve_2026_98432_guard-k4.18.o   (legacy maps, helper 26)
#   cve_2026_98432_guard-k5.10.o   (BTF maps, helper 25)
#   cve_2026_98432_guard-k6.6.o    (BTF maps, helper 25)
#
# The userspace binaries are kernel-independent and keep their plain
# names.
# ---------------------------------------------------------------------------
GUARD_OBJ="$SCRIPT_DIR/cve_2026_98432_guard-k${KERNEL_MAJOR}.${KERNEL_MINOR}.o"
PROBE_BIN="$SCRIPT_DIR/xdp_option_probe"
DAEMON_BIN="$SCRIPT_DIR/mtcp-guardd"
CTL_BIN="$SCRIPT_DIR/mtcp-guard-ctl"

CHECK_SCRIPT="$SCRIPT_DIR/check-bpf-support"

TMP_GUARD=""
TMP_PROBE=""
TMP_DAEMON=""
TMP_CTL=""

cleanup() {
    [[ -z "$TMP_GUARD" ]]  || rm -f -- "$TMP_GUARD"
    [[ -z "$TMP_PROBE" ]]  || rm -f -- "$TMP_PROBE"
    [[ -z "$TMP_DAEMON" ]] || rm -f -- "$TMP_DAEMON"
    [[ -z "$TMP_CTL" ]]    || rm -f -- "$TMP_CTL"
}
trap cleanup EXIT

fail() {
    err "$*"
    exit 1
}

# ---------------------------------------------------------------------------
# 0. Verify the source tree layout
# ---------------------------------------------------------------------------
if [[ ! -d "$SRC_DIR" ]]; then
    fail "Source directory not found: $SRC_DIR"
fi

# ---------------------------------------------------------------------------
# 1. Check kernel capabilities
# ---------------------------------------------------------------------------
[[ -f "$CHECK_SCRIPT" ]] || fail "Missing $CHECK_SCRIPT"

echo "[1/4] Checking kernel BPF/XDP support..."
CHECK_OUTPUT="$(bash "$CHECK_SCRIPT" 2>&1)" || {
    printf '%s\n' "$CHECK_OUTPUT"
    fail "BPF capability check failed"
}
printf '%s\n' "$CHECK_OUTPUT"

for config in CONFIG_BPF CONFIG_BPF_SYSCALL CONFIG_NET CONFIG_INET; do
    grep -Eq "^\[OK\][[:space:]]+${config}[[:space:]]+enabled$" \
        <<< "$CHECK_OUTPUT" ||
        fail "$config is not enabled or could not be confirmed"
done

# ---------------------------------------------------------------------------
# 2. Check build dependencies
# ---------------------------------------------------------------------------
echo
echo "[2/4] Checking build dependencies..."
command -v "$CLANG" >/dev/null 2>&1 ||
    fail "Clang not found: $CLANG"
command -v "$CC" >/dev/null 2>&1 ||
    fail "GCC not found: $CC"
ok "Clang found: $("$CLANG" --version | head -n 1)"
ok "GCC found: $("$CC" --version | head -n 1)"
info "BPF target support will be tested during compilation."

# --- libbpf (required for userspace tools) ---
if [[ "$BUILD_USERSPACE" -eq 0 ]]; then
    warn "Userspace tools disabled via --no-userspace"
    HAVE_LIBBPF=0
elif command -v pkg-config >/dev/null 2>&1 && pkg-config --exists libbpf 2>/dev/null; then
    ok "libbpf found (userspace tools will be built)"
    HAVE_LIBBPF=1
else
    warn "libbpf not found via pkg-config; userspace tools (mtcp-guardd, mtcp-guard-ctl) will NOT be built"
    warn "Install libbpf development headers and re-run:"
    warn "  Debian/Ubuntu: sudo apt install libbpf-dev"
    warn "  RHEL/Fedora:   sudo dnf install libbpf-devel"
    HAVE_LIBBPF=0
fi

# --- libpcap (optional, enables -p in the daemon) ---
HAVE_PCAP=0
DAEMON_PCAP_LIBS=""
DAEMON_PCAP_DEFS=""
DAEMON_PCAP_SRCS=""

if [[ "$HAVE_LIBBPF" -eq 1 ]] && [[ "$BUILD_PCAP" -eq 1 ]]; then
    if command -v pkg-config >/dev/null 2>&1 && pkg-config --exists libpcap 2>/dev/null; then
        if [[ -r "$DAEMON_PCAP_SRC" ]] && [[ -r "$DAEMON_PCAP_HDR" ]]; then
            ok "libpcap found (daemon -p capture will be available)"
            HAVE_PCAP=1
            DAEMON_PCAP_LIBS="-lpcap"
            DAEMON_PCAP_DEFS="-DHAVE_PCAP"
            DAEMON_PCAP_SRCS="$DAEMON_PCAP_SRC"
        else
            warn "libpcap found but $DAEMON_PCAP_SRC/$DAEMON_PCAP_HDR missing; -p disabled"
        fi
    else
        warn "libpcap not found; daemon will be built WITHOUT pcap capture (-p disabled)"
        warn "  install libpcap-dev / libpcap-devel to enable -p"
    fi
elif [[ "$HAVE_LIBBPF" -eq 1 ]] && [[ "$BUILD_PCAP" -eq 0 ]]; then
    warn "pcap capture disabled via --no-pcap"
fi

# --- libsystemd (optional, direct journald logging) ---
DAEMON_SYSTEMD_LIBS=""
if [[ "$HAVE_LIBBPF" -eq 1 ]]; then
    if command -v pkg-config >/dev/null 2>&1 && pkg-config --exists libsystemd 2>/dev/null; then
        ok "libsystemd found (daemon logs directly to journald)"
        DAEMON_SYSTEMD_LIBS="-lsystemd"
    else
        warn "libsystemd not found; daemon will use syslog() fallback"
        warn "  install libsystemd-dev / systemd-devel for direct journald"
    fi
fi

# ---------------------------------------------------------------------------
# 3. Check source files
# ---------------------------------------------------------------------------
echo
echo "[3/4] Checking source files..."
[[ -r "$GUARD_SRC" ]] || fail "Missing $GUARD_SRC"
[[ -r "$PROBE_SRC" ]] || fail "Missing $PROBE_SRC"
if [[ "$HAVE_LIBBPF" -eq 1 ]]; then
    [[ -r "$DAEMON_SRC" ]] || fail "Missing $DAEMON_SRC"
    [[ -r "$CTL_SRC" ]]    || fail "Missing $CTL_SRC"
    if [[ "$HAVE_PCAP" -eq 1 ]]; then
        [[ -r "$DAEMON_PCAP_SRC" ]] || fail "Missing $DAEMON_PCAP_SRC"
        [[ -r "$DAEMON_PCAP_HDR" ]] || fail "Missing $DAEMON_PCAP_HDR"
    fi
fi

TMP_GUARD="$(mktemp "$SCRIPT_DIR/.guard.XXXXXX")"
TMP_PROBE="$(mktemp "$SCRIPT_DIR/.probe.XXXXXX")"

# ---------------------------------------------------------------------------
# 4. Compile
# ---------------------------------------------------------------------------
echo
echo "[4/4] Compiling..."

GUARD_DEFS=(
    "-DLEGACY_MAPS=${LEGACY_MAPS}"
    "-DBPF_FUNC_PERF_EVENT_OUTPUT=${PERF_EVENT_OUTPUT_ID}"
)

if [[ "$LEGACY_MAPS" -eq 1 ]]; then
    GUARD_DEBUG_FLAGS=()
else
    GUARD_DEBUG_FLAGS=(-g)
fi

"$CLANG" -O2 "${GUARD_DEBUG_FLAGS[@]}" -target bpf -Wall -Wextra \
    "${GUARD_DEFS[@]}" \
    -c "$GUARD_SRC" \
    -o "$TMP_GUARD"
ok "eBPF object compiled (LEGACY_MAPS=${LEGACY_MAPS})"

"$CC" -O2 -Wall -Wextra \
    -o "$TMP_PROBE" "$PROBE_SRC"
ok "Packet probe compiled"

if [[ "$HAVE_LIBBPF" -eq 1 ]]; then
    TMP_DAEMON="$(mktemp "$SCRIPT_DIR/.daemon.XXXXXX")"
    TMP_CTL="$(mktemp "$SCRIPT_DIR/.ctl.XXXXXX")"

    # -I$SRC_DIR so pcap_writer.h is found when compiling mtcp-guardd.c
    # shellcheck disable=SC2086
    "$CC" -O2 -Wall -Wextra -I"$SRC_DIR" \
        $DAEMON_PCAP_DEFS \
        -o "$TMP_DAEMON" \
        "$DAEMON_SRC" $DAEMON_PCAP_SRCS \
        -lbpf -lelf $DAEMON_PCAP_LIBS $DAEMON_SYSTEMD_LIBS
    if [[ "$HAVE_PCAP" -eq 1 ]]; then
        ok "Daemon compiled: $DAEMON_BIN (with pcap capture)"
    else
        ok "Daemon compiled: $DAEMON_BIN (no pcap capture)"
    fi

    "$CC" -O2 -Wall -Wextra \
        -o "$TMP_CTL" "$CTL_SRC" -lbpf -lelf
    ok "Config utility compiled: $CTL_BIN"
fi

# ---------------------------------------------------------------------------
# Publish only after all compilations succeed.
# ---------------------------------------------------------------------------
mv -f -- "$TMP_GUARD" "$GUARD_OBJ"
TMP_GUARD=""
mv -f -- "$TMP_PROBE" "$PROBE_BIN"
TMP_PROBE=""

if [[ "$HAVE_LIBBPF" -eq 1 ]]; then
    mv -f -- "$TMP_DAEMON" "$DAEMON_BIN"
    TMP_DAEMON=""
    mv -f -- "$TMP_CTL" "$CTL_BIN"
    TMP_CTL=""
fi

echo
ok "BUILD SUCCESSFUL"
info "eBPF object:    $GUARD_OBJ"
info "Probe binary:   $PROBE_BIN"
if [[ "$HAVE_LIBBPF" -eq 1 ]]; then
    info "Daemon binary:  $DAEMON_BIN$([[ "$HAVE_PCAP" -eq 1 ]] && echo ' (with pcap)' || echo ' (no pcap)')"
    info "Config utility: $CTL_BIN"
fi
